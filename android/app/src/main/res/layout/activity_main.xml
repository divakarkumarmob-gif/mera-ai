<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/friday_black"
    android:padding="20dp">

    <!-- Top Bar: Header & Status Badge -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="FRIDAY AI"
            android:textColor="@color/friday_cyan"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="ONLINE"
            android:textColor="@color/friday_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle info -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎧 Bluetooth Headset Button Control Active"
        android:textColor="@color/friday_text_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Center Glowing Friday Orb Container -->
    <FrameLayout
        android:id="@+id/orbContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintBottom_toTopOf="@id/cardTranscript"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <!-- Outer Pulsing Glow -->
        <View
            android:id="@+id/orbOuterRing"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/orb_outer_ring" />

        <!-- Middle Glow Ring -->
        <View
            android:id="@+id/orbMiddleRing"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/orb_middle_ring" />

        <!-- Inner Core Orb -->
        <View
            android:id="@+id/orbCore"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/orb_core" />

        <!-- Status Icon / Text inside Orb -->
        <TextView
            android:id="@+id/tvOrbState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.15"
            android:text="STANDBY"
            android:textColor="@color/friday_text_main"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Transcript / Live Response Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranscript"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/friday_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/friday_card_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Press your Bluetooth button (or tap Mic below) to speak with Friday."
                android:textColor="@color/friday_text_main"
                android:textSize="15sp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Action Control Buttons -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mic Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="🎙️ Mic"
            android:textColor="@color/friday_black"
            app:backgroundTint="@color/friday_cyan"
            app:cornerRadius="14dp" />

        <!-- Briefing Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBriefing"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="⚡ Briefing"
            android:textColor="@color/friday_text_main"
            app:backgroundTint="@color/friday_card"
            app:cornerRadius="14dp"
            app:strokeColor="@color/friday_card_stroke"
            app:strokeWidth="1dp" />

        <!-- SOS Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSos"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="🚨 SOS"
            android:textColor="@color/friday_text_main"
            app:backgroundTint="@color/friday_red"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
