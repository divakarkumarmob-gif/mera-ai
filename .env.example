# Render Live Cloud Backend URL
VITE_BACKEND_URL=https://mera-ai-3496.onrender.com

# Required: your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Public API tools — Batch 4 (key required). All optional: if a key is
# missing, that specific tool just returns a "not configured" message
# instead of crashing the server.
# ---------------------------------------------------------------------------
# News — free signup at https://newsdata.io
NEWSDATA_API_KEY=
# Cricket scores — free signup at https://cricapi.com
CRICAPI_KEY=
# Sports events (football/NBA/etc) — free signup at https://www.thesportsdb.com/free_sports_api
# Optional — falls back to TheSportsDB's shared test key if left blank.
SPORTSDB_API_KEY=
# Stock prices — free signup at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Movies/OTT info — free signup at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Stock photos — free signup at https://www.pexels.com/api
PEXELS_API_KEY=
# Stock photos — free signup at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Directions/maps — free signup at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
# Nutrition/calorie info — free signup at https://developer.edamam.com
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# Recipe search — free signup at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=
# Flight status — free signup at https://aviationstack.com
AVIATIONSTACK_API_KEY=
# India govt open data catalog — free signup at https://data.gov.in (My Account -> API keys)
DATA_GOV_IN_API_KEY=
# Barcode/product lookup — optional, free tier works without a key (~100
# lookups/day). Sign up at https://www.upcitemdb.com for a higher limit.
UPCITEMDB_USER_KEY=
# Indian Railways (trains, schedule, PNR) — RapidAPI "IRCTC1" API.
# Get the "Application Key" from your RapidAPI console (rapidapi.com/console).
# WARNING: free tier is very limited (~50 calls/month) — use sparingly.
RAPIDAPI_KEY=

# Recommended: a long random string used to encrypt chat history at rest in
# Firestore. If you don't set this, history is still encrypted but with a
# random key that changes every server restart (so old history becomes
# unreadable after a restart). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Firebase (Firestore) — required. All chat history, memory, contacts,
# reminders, and notes are stored in Firestore instead of local files.
#
# Get these 3 values from: Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key (downloads a JSON file).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON. Keep it on one line
# with literal \n sequences for newlines (this is how the JSON stores it) —
# do NOT replace them with real line breaks in this file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: your own WhatsApp number (with country code, no + or spaces,
# e.g. 919876543210). If set, reminders are delivered to this number via
# the paired WhatsApp bot even when the app isn't open.
OWNER_WHATSAPP_NUMBER=

# Optional: port (Render sets this automatically, you usually don't need to set it)
PORT=3000

# ---------------------------------------------------------------------------
# Coding Agent — lets Friday propose code changes to this repo (as a PR, on
# a new branch, never directly to main). Approve/deny from the in-app
# dashboard or by replying "yes"/"ok" (approve) or anything else (deny) on
# WhatsApp when a plan is sent to OWNER_WHATSAPP_NUMBER.
# ---------------------------------------------------------------------------

# Fine-grained GitHub Personal Access Token, scoped to ONLY this repo, with
# "Contents: Read and write" and "Pull requests: Read and write" permissions.
GITHUB_TOKEN=

# "owner/repo", e.g. "your-username/mera-ai-master"
GITHUB_REPO=

# Optional: base branch to open PRs against. Defaults to "main".
GITHUB_BASE_BRANCH=main

# ---------------------------------------------------------------------------
# Dedicated Security Sentinel Telegram Bot (Dual-Layer Authenticated)
# ---------------------------------------------------------------------------
# 1. Bot token from @BotFather for the dedicated security sentinel bot
TELEGRAM_SECURITY_BOT_TKENO=

# 2. Boss DK's personal Telegram Chat ID (Only this Chat ID can use the bot)
BOSS_TELEGRAM_CHAT_ID=

# 3. Master App Key / Password (Requested upon /start before unlocking commands)
APP_KEY=
